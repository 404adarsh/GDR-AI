# =================================================================
# GDR AI / Aarushi AI - Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your keys:
# Linux/macOS: cp .env.example .env
# Windows: copy .env.example .env
#
# IMPORTANT: Never commit .env to any public Git repository!
# =================================================================

# -----------------------------------------------------------------
# 0. IDENTITY & PERSONALIZATION
# -----------------------------------------------------------------
# Your name (how your assistant will address you in chat, voice, and memory):
USER_NAME=YourName
# Assistant name (Default: GDR-AI, or custom e.g. Aarushi, Jarvis, Friday):
ASSISTANT_NAME=GDR-AI

# -----------------------------------------------------------------
# 1. PRIMARY AI ENGINE (Sarvam AI Cloud)
# -----------------------------------------------------------------
# Get your API key from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b-conversations

# -----------------------------------------------------------------
# 2. MARKANM CONNECT BOT PLATFORM (Recommended Bot Platform)
# -----------------------------------------------------------------
# Create a bot & get token at: https://chat.markanm.com/developers
# Format: mkbot_xxxxxxxxxxxxxxxxxxxxxxxx
MARKANM_BOT_TOKEN=your_markanm_bot_token_here
ALLOWED_MARKANM_USERNAME=your_markanm_username

# -----------------------------------------------------------------
# 3. TELEGRAM BOT CHANNEL (Optional)
# -----------------------------------------------------------------
# Create a bot via @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here
ALLOWED_TELEGRAM_USERNAME=your_telegram_username

# -----------------------------------------------------------------
# 4. MASTER SECURITY PASSWORDS & PINS
# -----------------------------------------------------------------
# Master password used on Telegram & MarkanM to verify your ownership:
BOT_MASTER_PASSWORD=your_secure_bot_password_here

# Master PIN to unlock and view the RAG Knowledge Vault in Web UI:
RAG_MASTER_PIN=your_secure_rag_pin_here

# -----------------------------------------------------------------
# 5. VOICE & AUDIO ENGINE (ElevenLabs & Edge-TTS)
# -----------------------------------------------------------------
# Get an ElevenLabs key from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID or link:
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_or_url

# -----------------------------------------------------------------
# 6. OPTIONAL FALLBACK LLM PROVIDERS
# -----------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------
# 7. EMAIL AUTOMATION (Optional)
# -----------------------------------------------------------------
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# -----------------------------------------------------------------
# 8. SEARCH & TOOLS (Optional)
# -----------------------------------------------------------------
WEATHER_API_KEY=
BRAVE_API_KEY=

# -----------------------------------------------------------------
# 9. SERVER NETWORKING
# -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8844
GDR_ALLOW_POWER=0

